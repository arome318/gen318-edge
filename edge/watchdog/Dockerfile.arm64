FROM python:3.12-slim-bookworm

# Platform: linux/arm64
LABEL maintainer="Gen318 <eng@gen318.io>"
LABEL description="Gen318 Edge Watchdog — container health + tamper detection"

WORKDIR /app

# Install system dependencies
# sqlcipher3 has no prebuilt wheel for linux/arm64, so pip compiles it:
# gcc is installed for that step and removed again in the same layer.
COPY requirements.txt /app/requirements.txt
RUN apt-get update && \
    apt-get install -y --no-install-recommends libsqlcipher-dev gcc && \
    pip install --no-cache-dir -r requirements.txt && \
    apt-get purge -y gcc && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Copy common modules and service code
COPY common/ /app/common/
COPY watchdog/ /app/watchdog/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["python", "-m", "watchdog.main"]

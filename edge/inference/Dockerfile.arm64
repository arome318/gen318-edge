FROM python:3.12-slim-bookworm

# Platform: linux/arm64
LABEL maintainer="Gen318 <eng@gen318.io>"
LABEL description="Gen318 Edge Inference — XGBoost on-device ML inference"

WORKDIR /app

# Install system dependencies for sqlcipher
RUN apt-get update && \
    apt-get install -y --no-install-recommends libsqlcipher-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy common modules and service code
COPY common/ /app/common/
COPY inference/ /app/inference/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["python", "-m", "inference.main"]

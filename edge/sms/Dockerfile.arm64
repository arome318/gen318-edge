FROM python:3.12-slim-bookworm

# Platform: linux/arm64
LABEL description="Gen318 Edge SMS: offline alerts, POWER status replies, technician labels"

WORKDIR /app

RUN pip install --no-cache-dir "paho-mqtt==2.1.0" "pyserial>=3.5" "pyyaml==6.0.2" "structlog==24.4.0"

COPY common/__init__.py common/mqtt_client.py /app/common/
COPY sms/ /app/sms/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["python", "-m", "sms.main"]
